    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst modelUsed = input.model || 'unknown';\nconst response = input.content || input.text || input.message?.content || JSON.stringify(input);\n\nreturn [{\n  json: {\n    eddy_response: {\n      model_used: modelUsed,\n      task_type: input.task_type || 'general',\n      response: response,\n      tokens_used: input.usage?.total_tokens || 0,\n      timestamp: new Date().toISOString(),\n      session_id: input.session_id\n    }\n  }\n}];"
      },
      "id": "formatter",
      "name": "Format EddY Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
