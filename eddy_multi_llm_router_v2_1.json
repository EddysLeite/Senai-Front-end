{
  "name": "EddY Core - Multi-LLM Router v2.1",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "eddy-router",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-inbound",
      "name": "Webhook Inbound",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "eddy-router"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst taskType = (body.task_type || body.target_ai || 'general').toLowerCase();\n\nconst modelMap = {\n  'code': 'gpt-4o',\n  'programming': 'gpt-4o',\n  'script': 'gpt-4o',\n  'review': 'claude-sonnet-4',\n  'documentation': 'claude-sonnet-4',\n  'long_text': 'gemini-2.5-pro',\n  'pdf': 'gemini-2.5-pro',\n  'research': 'grok-3',\n  'search': 'grok-3',\n  'creative': 'kimi-latest',\n  'summary': 'kimi-latest',\n  'general': 'gpt-4o-mini'\n};\n\nconst selectedModel = modelMap[taskType] || modelMap['general'];\n\nreturn [{\n  json: {\n    prompt: body.prompt || body.message || body.content,\n    task_type: taskType,\n    model: selectedModel,\n    context: body.context || '',\n    session_id: body.session_id || Date.now().toString(),\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "classifier",
      "name": "Task Classifier",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "rules": [
            {
              "value": "gpt-4o",
              "output": 0
            },
            {
              "value": "gpt-4o-mini",
              "output": 0
            },
            {
              "value": "claude-sonnet-4",
              "output": 1
            },
            {
              "value": "gemini-2.5-pro",
              "output": 2
            },
            {
              "value": "gemini-2.5-flash",
              "output": 2
            },
            {
              "value": "grok-3",
              "output": 3
            },
            {
              "value": "grok-3-mini",
              "output": 3
            },
            {
              "value": "kimi-latest",
              "output": 4
            },
            {
              "value": "kimi-k2",
              "output": 4
            }
          ]
        },
        "dataType": "string",
        "value1": "={{ $json.model }}",
        "fallbackOutput": 0
      },
      "id": "router",
      "name": "Model Router",
